rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasLink() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accountLinks/$(request.auth.uid));
    }

    function link() {
      return get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data;
    }

    function hasAccount() {
      return hasLink()
        && link().internalAccountId is string
        && exists(/databases/$(database)/documents/users/$(link().internalAccountId));
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(link().internalAccountId)).data;
    }

    function isConsistentIdentity() {
      return hasAccount()
        && request.auth.token.email_verified == true
        && link().keys().hasAll([
          'authUid',
          'internalAccountId',
          'role',
          'schoolId',
          'status',
          'createdAt',
          'linkedBy'
        ])
        && link().keys().hasOnly([
          'authUid',
          'internalAccountId',
          'role',
          'schoolId',
          'status',
          'createdAt',
          'linkedBy',
          'classId'
        ])
        && link().authUid == request.auth.uid
        && link().internalAccountId is string
        && link().role is string
        && link().schoolId is string
        && link().status is string
        && link().createdAt is timestamp
        && link().linkedBy is string
        && account().keys().hasAll(['authUid', 'contactEmail'])
        && account().authUid == request.auth.uid
        && account().contactEmail is string
        && link().role == account().role
        && link().schoolId == account().schoolId
        && link().status == account().status
        && account().role in ['super_admin', 'admin', 'teacher', 'student']
        && (
          account().role != 'super_admin'
          || link().internalAccountId == 'super-admin-root'
        )
        && (account().role != 'student' || link().classId is string)
        && account().status in ['active', 'locked', 'pending'];
    }

    function isActiveUser() {
      return isConsistentIdentity()
        && link().status == 'active'
        && account().status == 'active';
    }

    function isSchoolAdmin(schoolId) {
      return isActiveUser()
        && (
          link().role == 'super_admin'
          || (link().role == 'admin' && link().schoolId == schoolId)
        );
    }

    function canReadSchoolRecords(schoolId) {
      return isActiveUser()
        && (
          link().role == 'super_admin'
          || (link().role in ['admin', 'teacher'] && link().schoolId == schoolId)
          || (
            link().role == 'student'
            && link().schoolId == schoolId
            && resource.data.classId == link().classId
            && resource.data.ownerUid == request.auth.uid
          )
        );
    }

    match /accountLinks/{uid} {
      allow get: if request.auth != null
        && request.auth.uid == uid
        && isActiveUser();
      allow list, create, update, delete: if false;
    }

    match /users/{internalAccountId} {
      allow get: if isActiveUser()
        && link().internalAccountId == internalAccountId;
      allow list, create, update, delete: if false;
    }

    match /schools/{schoolId} {
      allow get, list: if isActiveUser()
        && (link().role == 'super_admin' || link().schoolId == schoolId);
      allow create, update, delete: if false;
    }

    match /schoolData/{schoolId}/records/{recordId} {
      allow get: if canReadSchoolRecords(schoolId);
      allow list: if isActiveUser()
        && (
          link().role == 'super_admin'
          || (link().role in ['admin', 'teacher'] && link().schoolId == schoolId)
          || (
            link().role == 'student'
            && link().schoolId == schoolId
            && resource.data.classId == link().classId
            && resource.data.ownerUid == request.auth.uid
          )
        );
      allow create: if isSchoolAdmin(schoolId)
        && request.resource.data.schoolId == schoolId;
      allow update: if isSchoolAdmin(schoolId)
        && resource.data.schoolId == schoolId
        && request.resource.data.schoolId == schoolId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
